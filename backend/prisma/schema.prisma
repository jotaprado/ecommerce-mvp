generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  customer
  support
  admin
}

enum DeliveryType {
  shipping
  pickup
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  role         Role       @default(customer)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  cartItems    CartItem[]
  orders       Order[]
}

model Product {
  id          String      @id @default(uuid())
  name        String
  description String
  price       Decimal
  brand       String
  category    String
  specs       Json
  stock       Int
  imageUrl    String
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([userId, productId])
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  status     OrderStatus @default(pending)
  total      Decimal
  trackingId String?     @unique
  createdAt  DateTime    @default(now())
  items      OrderItem[]
  payment    Payment?

  // total = subtotal + shippingCost. Los pedidos antiguos tienen envío 0 y entrega nula.
  deliveryType    DeliveryType?
  shippingAddress Json?
  pickupStore     String?
  shippingCost    Decimal       @default(0)
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal
}

model Payment {
  id                String   @id @default(uuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  gatewayReference  String
  status            String
  amount            Decimal

  // Solo marca y últimos 4 dígitos: nunca el número completo ni el CVV.
  method    String?
  cardBrand String?
  cardLast4 String?
}

// Registro de cada intento procesado por processPayment (aprobado o rechazado).
// orderId sin FK: un intento rechazado no tiene orden.
model PaymentAttempt {
  id        String   @id @default(uuid())
  userId    String
  orderId   String?
  method    String
  amount    Decimal
  status    String
  reason    String?
  cardBrand String?
  cardLast4 String?
  createdAt DateTime @default(now())
}
